      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(rednexus_match_latency_seconds_bucket[$__range])))",
          "instant": true
        }
      ]
    },
