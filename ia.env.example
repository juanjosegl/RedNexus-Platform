# Nivel 2 de la guía de instalación: IA real con Ollama.
# Copia este archivo como .env en la carpeta RedNexus-Platform y vuelve a levantar el stack:
#   Mac/Linux:  cp ia.env.example .env
#   Windows:    copy ia.env.example .env
# Antes: instalar Ollama (https://ollama.com) y descargar los modelos
#   ollama pull qwen2.5:3b
#   ollama pull paraphrase-multilingual
AI_PROVIDER=ollama

# Opcional, notas de voz reales con whisper.cpp (ver docs/demo-local.md):
# TRANSCRIBE_PROVIDER=whisper

# Opcional, asistente de /ayuda con Open WebUI (ver asistente-rag/README.md):
# SUPPORT_PROVIDER=openwebui
# OPENWEBUI_API_KEY=pega-aqui-tu-api-key
